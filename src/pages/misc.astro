---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ResourceLinks from '../components/ResourceLinks.astro';
import DevGapsPanel from '../components/DevGapsPanel.astro';
import Icon from '../components/Icon.astro';
import DevGaps from '../components/DevGaps.astro';
import { site } from '../site.config';
import { misc, showMisc } from '../data/misc';
import { getMiscImage } from '../lib/media';
import { inline } from '../lib/text';
import { withBase } from '../lib/url';

const entries = misc.entries.map((entry) => ({
  ...entry,
  img: getMiscImage(entry.image?.file),
  photos: (entry.images ?? []).map((p) => ({ ...p, img: getMiscImage(p.file) })),
}));
---

<BaseLayout
  title={`${misc.title} · ${site.author.name}`}
  description={`${misc.title}: ${site.author.name} away from robot learning research.`}
  noindex={!showMisc}
>
  <SiteHeader current="misc" />

  <main id="main">
    <div id="top" class="mx-auto max-w-page px-5 pt-14 pb-20 sm:px-8 sm:pt-20 lg:pb-28">
      <header class="grid gap-x-12 gap-y-3 border-b border-rule pb-10 lg:grid-cols-[12rem_minmax(0,1fr)]">
        <p class="eyebrow flex items-center gap-3 lg:pt-1">
          <span class="text-accent">Misc</span>
          <span aria-hidden="true" class="h-px w-8 bg-rule-strong"></span>
        </p>
        <div>
          <h1 class="text-[2.4rem] leading-tight font-medium text-ink sm:text-[2.9rem]">{misc.title}</h1>
          {misc.lead && <p class="mt-3 max-w-prose text-[1.05rem] leading-relaxed text-ink-2">{misc.lead}</p>}
        </div>
      </header>

      {
        showMisc ? (
          <ul class="mt-4">
            {entries.map((entry) => (
              <li class="grid gap-x-12 gap-y-2 border-b border-rule py-10 last:border-b-0 lg:grid-cols-[12rem_minmax(0,1fr)]">
                <p class:list={['font-mono text-[0.72rem] leading-7 tracking-wider text-ink-3 uppercase', !entry.period && 'hidden lg:block']}>
                  {entry.period}
                </p>
                <div
                  class:list={[
                    'grid min-w-0 gap-6',
                    entry.image && 'md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-10',
                  ]}
                >
                  {entry.image && !entry.img && (
                    <div
                      class="grid-paper relative flex aspect-[4/3] w-full flex-col justify-between overflow-hidden rounded-lg border border-rule p-4"
                      role="img"
                      aria-label={`Photo of ${entry.title.toLowerCase()} coming soon`}
                    >
                      <span class="eyebrow" aria-hidden="true">Photo coming soon</span>
                      <span class="font-serif text-[1.85rem] leading-none font-light text-ink/70" aria-hidden="true">
                        {entry.title}
                      </span>
                    </div>
                  )}
                  {entry.img && entry.image && (
                    <figure>
                      <Picture
                        src={entry.img}
                        alt={entry.image.alt}
                        widths={[400, 640, 960]}
                        sizes="(min-width: 1024px) 380px, (min-width: 768px) 40vw, 100vw"
                        formats={['avif', 'webp']}
                        class="aspect-[4/3] w-full rounded-lg border border-rule object-cover"
                      />
                      {entry.image.caption && (
                        <figcaption class="mt-2 text-[0.8rem] text-ink-3">{entry.image.caption}</figcaption>
                      )}
                    </figure>
                  )}
                  <div class="max-w-prose">
                    <h2 class="text-[1.5rem] leading-snug font-medium text-ink">{entry.title}</h2>
                    <p class="mt-2.5 text-[1rem] leading-relaxed text-ink-2" set:html={inline(entry.text)} />
                    {entry.links && <ResourceLinks links={entry.links} context={entry.title} class="mt-4" />}
                    <DevGaps gaps={entry.gaps} />
                  </div>
                  {entry.photos.length > 0 && (
                    <div class="grid gap-4 sm:grid-cols-2 sm:gap-5">
                      {entry.photos.map((p) =>
                        p.img ? (
                          <Picture
                            src={p.img}
                            alt={p.alt}
                            widths={[480, 720, 1000]}
                            sizes="(min-width: 1024px) 420px, (min-width: 640px) 45vw, 100vw"
                            formats={['avif', 'webp']}
                            class="aspect-[4/5] w-full rounded-lg object-cover"
                          />
                        ) : (
                          <DevGaps gaps={[`Missing photo: src/assets/misc/${p.file}`]} />
                        ),
                      )}
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <div class="mt-12 max-w-prose">
            <p class="text-ink-2">Nothing here yet. Check back soon.</p>
            {import.meta.env.DEV && (
              <p class="mt-4 rounded-md border border-dashed border-accent/50 bg-accent-soft/40 px-3 py-2 font-mono text-[0.75rem] text-accent-strong">
                TODO · Add entries to src/data/misc.ts. Until then this page is hidden from the nav and sitemap and marked noindex.
              </p>
            )}
          </div>
        )
      }

      <a href={withBase('/')} class="link mt-12 inline-flex items-center gap-1.5 text-[0.92rem]">
        <Icon name="arrow-right" class="size-3.5 rotate-180" />
        Back to research
      </a>
    </div>
  </main>

  <SiteFooter />
  <DevGapsPanel />
</BaseLayout>
