---
/**
 * Floating checklist of every known content gap. Development only:
 * `npm run dev` shows it, production builds never include it.
 */
import { collectGaps } from '../lib/gaps';

const groups = import.meta.env.DEV ? collectGaps() : [];
const total = groups.reduce((n, g) => n + g.items.length, 0);
---

{
  import.meta.env.DEV && total > 0 && (
    <details class="fixed right-4 bottom-4 z-50 max-h-[70vh] w-[22rem] max-w-[calc(100vw-2rem)] overflow-auto rounded-lg border border-accent/40 bg-paper text-[0.78rem] shadow-lg">
      <summary class="cursor-pointer px-4 py-2.5 font-mono text-accent-strong">
        Content gaps ({total}) · dev only
      </summary>
      <div class="space-y-3 border-t border-rule px-4 py-3">
        {groups.map((g) => (
          <div>
            <p class="font-medium text-ink">{g.area}</p>
            <ul class="mt-1 list-disc space-y-0.5 pl-4 text-ink-2">
              {g.items.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </details>
  )
}
