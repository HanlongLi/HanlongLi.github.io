---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import CvLink from './CvLink.astro';
import { site } from '../site.config';
import { profile } from '../data/profile';
import { getPortraitImage } from '../lib/media';
import { inline } from '../lib/text';
import type { IconName } from '../lib/icons';

const portrait = getPortraitImage(profile.portrait.file || undefined);

const allContacts: { label: string; href: string; icon: IconName }[] = [
  { label: 'Email', href: `mailto:${site.contact.email}`, icon: 'mail' },
  { label: 'GitHub', href: site.contact.github, icon: 'github' },
  { label: 'Google Scholar', href: site.contact.scholar, icon: 'scholar' },
  { label: 'LinkedIn', href: site.contact.linkedin, icon: 'linkedin' },
];
const contacts = allContacts.filter((c) => c.href);
---

<section id="top" aria-labelledby="hero-name" class="mx-auto max-w-page px-5 pt-12 pb-14 sm:px-8 sm:pt-20 lg:pt-24 lg:pb-20">
  <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_16.5rem] lg:gap-16">
    <div class="min-w-0">
      <p class="eyebrow mb-5 text-accent">{profile.tagline}</p>

      <div class="flex items-center justify-between gap-5">
        <div>
          <h1 id="hero-name" class="text-display font-medium text-ink">
            {site.author.name}
          </h1>
          {
            site.author.alias && (
              <p class="mt-3 text-[0.95rem] text-ink-3">
                Also goes by <span class="text-ink-2">{site.author.alias}</span>
              </p>
            )
          }
        </div>
        {
          portrait && (
            <Picture
              src={portrait}
              alt={profile.portrait.alt}
              widths={[96, 192]}
              sizes="96px"
              formats={['avif', 'webp']}
              loading="eager"
              class="size-24 shrink-0 rounded-full border border-rule object-cover object-[50%_28%] lg:hidden"
            />
          )
        }
      </div>

      <p
        class="mt-7 max-w-[36rem] font-serif text-[1.45rem] leading-[1.35] text-ink sm:text-[1.7rem] [&_em]:text-accent [&_em]:not-italic"
        set:html={inline(profile.statement)}
      />

      <dl class="mt-8 grid gap-3 border-l-2 border-accent/70 pl-4 sm:gap-2">
        {
          profile.currentRole.map((r) => (
            <div class="flex flex-col gap-x-2 sm:flex-row sm:flex-wrap sm:items-baseline">
              <dt class="text-[0.95rem] font-medium text-ink">
                {r.role}, <span class="font-semibold">{r.place}</span>
              </dt>
              <dd class="text-[0.9rem] text-ink-3">
                <span class="hidden sm:inline" aria-hidden="true">· </span>
                {r.detail}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-7 max-w-[42rem] space-y-4 text-[1.05rem] leading-[1.7] text-ink-2 [&_strong]:font-semibold [&_strong]:text-ink">
        {profile.intro.map((p) => <p set:html={inline(p)} />)}
      </div>

      {
        site.applicationNote && (
          <p class="mt-6 inline-flex items-start gap-2.5 rounded-md bg-accent-soft px-3 py-2 text-[0.9rem] text-accent-strong">
            <span aria-hidden="true" class="mt-[0.45rem] size-1.5 shrink-0 rounded-full bg-accent" />
            {site.applicationNote}
          </p>
        )
      }

      <div class="mt-8 flex flex-wrap items-center gap-x-2 gap-y-3">
        <CvLink variant="primary" />
        <ul class="flex flex-wrap items-center gap-1 sm:ml-2" aria-label="Contact and profiles">
          {
            contacts.map((c) => (
              <li>
                <a
                  href={c.href}
                  {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer me' } : {})}
                  class="inline-flex items-center gap-2 rounded-md px-3 py-2.5 text-sm text-ink-2 transition-colors hover:bg-panel hover:text-accent"
                >
                  <Icon name={c.icon} class="size-4" />
                  <span>{c.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <figure class="hidden w-full lg:mt-12 lg:block lg:max-w-[16.5rem]">
      {
        portrait ? (
          <Picture
            src={portrait}
            alt={profile.portrait.alt}
            widths={[264, 400, 528]}
            sizes="(min-width: 1024px) 264px, 66vw"
            formats={['avif', 'webp']}
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/5] w-full rounded-lg object-cover"
          />
        ) : (
          <div
            class="grid-paper relative grid aspect-[4/5] w-full place-items-center overflow-hidden rounded-lg border border-rule"
            role="img"
            aria-label="Monogram HL"
          >
            <span class="font-serif text-[5.5rem] leading-none font-light tracking-tight text-ink/85">
              H<span class="text-accent">L</span>
            </span>
            <span class="eyebrow absolute top-3 left-3">Robot learning</span>
            <span class="eyebrow absolute right-3 bottom-3">Embodied AI</span>
          </div>
        )
      }
      <figcaption class="mt-3 flex items-center gap-1.5 text-[0.82rem] text-ink-3">
        <Icon name="pin" class="size-3.5" />
        {site.author.location}
      </figcaption>
    </figure>
  </div>
</section>
