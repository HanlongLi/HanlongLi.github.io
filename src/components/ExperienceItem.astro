---
import DevGaps from './DevGaps.astro';
import { projects } from '../data/research';
import type { Experience } from '../data/types';

interface Props {
  item: Experience;
}

const { item } = Astro.props;
const related = (item.projectIds ?? [])
  .map((id) => projects.find((p) => p.id === id))
  .filter((p) => p !== undefined);
---

<li class="grid gap-x-6 gap-y-1.5 border-b border-rule py-7 first:pt-0 last:border-b-0 sm:grid-cols-[9.25rem_minmax(0,1fr)]">
  <p class="font-mono text-[0.75rem] leading-6 text-ink-3">
    <time>{item.start}</time> – <time>{item.end}</time>
  </p>
  <div class="min-w-0">
    <h4 class="text-[1.2rem] leading-snug font-medium text-ink">
      {item.unit ?? item.organization}
    </h4>
    <p class="mt-0.5 text-[0.92rem] text-ink-2">
      <span class="font-medium text-ink">{item.role}</span>
      {item.unit && <> · {item.organization}</>}
      {item.location && <span class="text-ink-3"> · {item.location}</span>}
    </p>
    {item.supervision && <p class="mt-0.5 text-[0.86rem] text-ink-3">{item.supervision}</p>}
    <ul class="mt-3 space-y-1.5 text-[0.93rem] leading-relaxed text-ink-2">
      {
        item.points.map((point) => (
          <li class="relative pl-4 before:absolute before:top-[0.7em] before:left-0 before:h-px before:w-2 before:bg-ink-3">
            {point}
          </li>
        ))
      }
    </ul>
    {
      related.length > 0 && (
        <p class="mt-3 text-[0.82rem] text-ink-3">
          Related:{' '}
          {related.map((p, i) => (
            <>
              <a class="link" href={`#research-${p.id}`}>
                {p.shortTitle}
              </a>
              {i < related.length - 1 && ', '}
            </>
          ))}
        </p>
      )
    }
    <DevGaps gaps={item.gaps} />
  </div>
</li>
