---
import FigureSlot from './FigureSlot.astro';
import ResourceLinks from './ResourceLinks.astro';
import DevGaps from './DevGaps.astro';
import Icon from './Icon.astro';
import { patents, publications } from '../data/publications';
import { projectPageForProject, projectPagePath } from '../data/projectPages';
import { getResearchImage } from '../lib/media';
import { isExternal, withBase } from '../lib/url';
import type { ResearchProject, ResourceLink } from '../data/types';

interface Props {
  project: ResearchProject;
  index: number;
}

const { project, index } = Astro.props;

const related = (project.publicationIds ?? [])
  .map((id) => {
    const pub = publications.find((p) => p.id === id);
    if (pub) return { id, label: pub.venueShort };
    const patent = patents.find((p) => p.id === id);
    if (patent) return { id, label: `U.S. Patent App. ${patent.year}` };
    console.warn(`[research] Unknown publication id "${id}" in project "${project.id}".`);
    return null;
  })
  .filter((r): r is { id: string; label: string } => r !== null);

const video = project.video;
const videoIsFile = video ? !isExternal(video.src) : false;
const page = projectPageForProject(project.id);
const hasFigure = Boolean(getResearchImage(project.figure?.file));
// A local demo video stands in for the figure until a figure exists.
const videoAsFigure = Boolean(video && videoIsFile && !hasFigure);
const links: ResourceLink[] = [
  ...(page ? [{ kind: 'project' as const, href: projectPagePath(page) }] : []),
  ...project.links,
  ...(video && !videoIsFile ? [{ kind: 'video' as const, href: video.src, label: video.label ?? 'Video' }] : []),
];
---

<article
  id={`research-${project.id}`}
  aria-labelledby={`research-${project.id}-title`}
  class="grid gap-6 md:grid-cols-2 md:gap-10 lg:gap-14"
>
  <div class="md:sticky md:top-[calc(var(--header-h)+1.5rem)] md:self-start md:pt-1">
    {
      !videoAsFigure && (
        <FigureSlot
          figure={project.figure}
          keywords={project.placeholderKeywords}
          title={project.title}
          label={project.shortTitle}
          index={index}
        />
      )
    }
    {
      video && videoIsFile && (
        <video
          class:list={['aspect-video w-full rounded-lg border border-rule bg-ink', !videoAsFigure && 'mt-3']}
          controls
          preload="none"
          playsinline
          {...(video.poster ? { poster: withBase(video.poster) } : {})}
        >
          <source src={withBase(video.src)} type="video/mp4" />
          <a href={withBase(video.src)}>Download the video</a>
        </video>
      )
    }
    {video?.label && videoIsFile && <p class="mt-2 text-[0.8rem] leading-snug text-ink-3">{video.label}</p>}
  </div>

  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <p class="font-mono text-[0.7rem] tracking-wider text-accent uppercase">{project.areas.join(' · ')}</p>
      {
        project.status === 'ongoing' && (
          <span class="inline-flex items-center gap-1.5 rounded-full border border-accent/30 px-2 py-px text-[0.68rem] font-medium text-accent">
            <span aria-hidden="true" class="size-1.5 rounded-full bg-accent" />
            Ongoing
          </span>
        )
      }
    </div>

    <h4 id={`research-${project.id}-title`} class="mt-2.5 text-[1.6rem] leading-[1.2] font-medium text-ink sm:text-[1.8rem]">
      {project.headline}
    </h4>
    <p class="mt-3 text-[0.95rem] leading-snug font-medium text-ink-2">{project.title}</p>
    <p class="mt-1 flex flex-wrap items-center gap-x-2 text-[0.86rem] text-ink-3">
      <span>{project.context}</span>
      <span aria-hidden="true">·</span>
      <span>{project.period}</span>
      {
        related.map((r) => (
          <>
            <span aria-hidden="true">·</span>
            <a href={`#pub-${r.id}`} class="link inline-flex items-center gap-0.5 font-medium">
              {r.label}
              <span class="sr-only"> (jump to citation)</span>
              <Icon name="arrow-right" class="size-3 rotate-90" />
            </a>
          </>
        ))
      }
    </p>

    {
      project.keyResult && (
        <p class="mt-4 flex flex-col gap-0.5 border-l-2 border-accent bg-accent-soft/60 py-2 pr-3 pl-3.5 sm:flex-row sm:items-baseline sm:gap-3">
          <span class="eyebrow shrink-0 text-accent">Key result</span>
          <span class="text-[0.95rem] leading-snug font-medium text-ink">{project.keyResult}</span>
        </p>
      )
    }

    <p class="mt-4 text-[0.98rem] leading-relaxed text-ink-2">{project.summary}</p>

    <dl class="mt-5 space-y-4">
      <div>
        <dt class="eyebrow mb-1.5">My contribution</dt>
        <dd>
          <ul class="space-y-1.5 text-[0.93rem] leading-relaxed text-ink-2">
            {
              project.contributions.map((c) => (
                <li class="relative pl-4 before:absolute before:top-[0.7em] before:left-0 before:h-px before:w-2 before:bg-ink-3">
                  {c}
                </li>
              ))
            }
          </ul>
        </dd>
      </div>

      {
        project.highlights && project.highlights.length > 0 && (
          <div>
            <dt class="eyebrow mb-1.5">{project.keyResult ? 'More results' : 'Results'}</dt>
            <dd>
              <ul class="space-y-1.5 text-[0.93rem] leading-relaxed text-ink-2">
                {project.highlights.map((h) => (
                  <li class="relative pl-4 before:absolute before:top-[0.6em] before:left-0 before:size-1.5 before:rounded-full before:bg-accent/70">
                    {h}
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        )
      }
    </dl>

    {
      project.disclosure?.status === 'pending' && (
        <p class="mt-5 border-l-2 border-rule-strong pl-3 text-[0.85rem] text-ink-3 italic">{project.disclosure.note}</p>
      )
    }

    <ResourceLinks links={links} context={project.shortTitle} class="mt-5" />

    <DevGaps gaps={project.gaps} />
  </div>
</article>
