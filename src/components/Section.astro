---
interface Props {
  id: string;
  number: string;
  title: string;
  /** Optional one-line introduction under the heading. */
  lead?: string;
  /** Header on top and content at full width (used for Research). */
  wide?: boolean;
  class?: string;
}

const { id, number, title, lead, wide = false, class: className = '' } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class:list={['border-t border-rule', className]}>
  {
    wide ? (
      <div class="mx-auto max-w-page px-5 py-16 sm:px-8 sm:py-20 lg:py-24">
        <header class="mb-12 grid gap-x-12 gap-y-3 lg:mb-14 lg:grid-cols-[12rem_minmax(0,1fr)] lg:items-end">
          <div>
            <p class="eyebrow mb-2 flex items-center gap-3">
              <span class="text-accent">{number}</span>
              <span aria-hidden="true" class="h-px w-8 bg-rule-strong" />
            </p>
            <h2 id={`${id}-title`} class="text-[1.85rem] leading-tight font-medium text-ink">
              {title}
            </h2>
          </div>
          {lead && <p class="max-w-prose text-[1.02rem] leading-relaxed text-ink-2 lg:pb-1">{lead}</p>}
        </header>
        <slot />
      </div>
    ) : (
      <div class="mx-auto grid max-w-page gap-x-12 gap-y-8 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[12rem_minmax(0,1fr)] lg:py-24">
        <header class="lg:sticky lg:top-[calc(var(--header-h)+2.5rem)] lg:self-start">
          <p class="eyebrow mb-2 flex items-center gap-3">
            <span class="text-accent">{number}</span>
            <span aria-hidden="true" class="h-px w-8 bg-rule-strong" />
          </p>
          <h2 id={`${id}-title`} class="text-[1.85rem] leading-tight font-medium text-ink">
            {title}
          </h2>
          {lead && <p class="mt-3 max-w-prose text-[0.95rem] leading-relaxed text-ink-2 lg:hidden">{lead}</p>}
        </header>
        <div class="min-w-0">
          {lead && <p class="mb-10 hidden max-w-prose text-[1.02rem] leading-relaxed text-ink-2 lg:block">{lead}</p>}
          <slot />
        </div>
      </div>
    )
  }
</section>
